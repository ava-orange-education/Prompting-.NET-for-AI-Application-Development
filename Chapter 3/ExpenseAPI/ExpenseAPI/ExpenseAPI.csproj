<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Disable apphost during development to avoid file locks on the produced .exe -->
    <UseAppHost>false</UseAppHost>
    <!-- Use a separate output subfolder for build outputs to avoid overwriting files used by a running instance -->
    <OutputPath>bin\Debug\net10.0\build\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.AI.OpenAI" Version="2.1.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.2" />
  </ItemGroup>

</Project>
